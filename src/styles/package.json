{
  "name": "its123api-styles",
  "version": "1.0.0",
  "description": "Themes for 123test API",
  "main": "index.js",
  "scripts": {
    "build": "sass scss:css --style=compressed --no-source-map",
    "minify": "sass scss:../../dist/css --style=compressed --no-source-map && postcss --use autoprefixer --replace ../../dist/css/themes/*.css",
    "watch": "sass --watch scss:css",
    "server": "browser-sync start --server --files='index.html,css/**/*.css'"
  },
  "repository": {
    "type": "git",
    "url": "github.com/123test/api-sdk"
  },
  "author": "Wouter Bulten",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "postcss-cli": "^11.0.0",
    "sass": "^1.80.0"
  }
}
